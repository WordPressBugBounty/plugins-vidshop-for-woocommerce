#: includes/abilities/class-videos-abilities.php:147
msgid "Update a VidShop video"
msgstr ""

#: includes/abilities/class-videos-abilities.php:148
msgid "Updates one shoppable video. This single ability covers renaming it, changing its poster frame, publishing or unpublishing it, and attaching WooCommerce products to it. Only the fields you send are changed; every field you omit is left exactly as it is."
msgstr ""

#: includes/abilities/class-videos-abilities.php:156
msgid "The VidShop video row ID to update, as returned by vidshop/list-videos."
msgstr ""

#: includes/abilities/class-videos-abilities.php:160
msgid "New title for the video, shown to shoppers in the storefront."
msgstr ""

#: includes/abilities/class-videos-abilities.php:164
msgid "Attachment ID of an image in the Media Library to use as the poster frame."
msgstr ""

#: includes/abilities/class-videos-abilities.php:169
msgid "Publication status: published makes the video live in storefronts, draft hides it. AI-generated videos arrive as drafts, so this is how you approve one."
msgstr ""

#: includes/abilities/class-videos-abilities.php:174
msgid "Per-video settings. The keys you send are merged into the stored settings, so keys you leave out keep their current values."
msgstr ""

#: includes/abilities/class-videos-abilities.php:181
msgid "WooCommerce product IDs to feature in this video. This is a full replace: any product not listed is detached."
msgstr ""

#: includes/abilities/class-videos-abilities.php:219
msgid "Restore a trashed VidShop video"
msgstr ""

#: includes/abilities/class-videos-abilities.php:220
msgid "Restores a video from the trash and returns it to draft status, clearing the deletion stamp. This is the undo half of vidshop/trash-video. It fails if the video is not currently in the trash."
msgstr ""

#: includes/abilities/class-videos-abilities.php:228
msgid "The VidShop video row ID to restore. List trashed videos with vidshop/list-videos using status \"trash\"."
msgstr ""

